\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Scenario 1: detumbling (4 orbits)}{3}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detumbling. The rotation rate decreases in one step per perigee pass: 10.09, 8.73, 7.84, 7.25 and \SI {6.77}{\degree /s} at the orbit marks.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:detumble}{{1}{4}{Detumbling. The rotation rate decreases in one step per perigee pass: 10.09, 8.73, 7.84, 7.25 and \SI {6.77}{\degree /s} at the orbit marks}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spacecraft orientation (3-2-1 Euler angles) during detumbling. The roll angle wraps continuously between \(\pm \ang {180}\) as the body keeps rotating; pitch and yaw oscillate in bands that narrow slowly as the rate decays.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:dt_orient}{{2}{4}{Spacecraft orientation (3-2-1 Euler angles) during detumbling. The roll angle wraps continuously between \(\pm \ang {180}\) as the body keeps rotating; pitch and yaw oscillate in bands that narrow slowly as the rate decays}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Detumbling, actuator view. (a) The stored rotation decreases from 29.0 to \SI {17.1}{N.m.s} in perigee steps. (b) The wheels are intentionally not used in this mode.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dt_pair1}{{3}{5}{Detumbling, actuator view. (a) The stored rotation decreases from 29.0 to \SI {17.1}{N.m.s} in perigee steps. (b) The wheels are intentionally not used in this mode}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Detumbling, environment view. (a) Without pointing control, the angle to the Sun covers the full range from \ang {0.3} to \ang {179}; this is expected. (b) Perigee peaks as in the pointing scenario; the drag peak is higher because the tumbling body also presents its largest face to the airflow.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:dt_pair2}{{4}{5}{Detumbling, environment view. (a) Without pointing control, the angle to the Sun covers the full range from \ang {0.3} to \ang {179}; this is expected. (b) Perigee peaks as in the pointing scenario; the drag peak is higher because the tumbling body also presents its largest face to the airflow}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Detumbling, budget and estimator view. (a) Only \SI {0.058}{N.m.s} accumulate, because the tumbling motion averages most of the disturbance away. (b) Knowledge error up to \ang {13.7} between star-tracker measurements; the bias estimate remains at \SI {3.91}{\degree \per \hour } because bias estimation is suspended at high rates.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:dt_pair3}{{5}{5}{Detumbling, budget and estimator view. (a) Only \SI {0.058}{N.m.s} accumulate, because the tumbling motion averages most of the disturbance away. (b) Knowledge error up to \ang {13.7} between star-tracker measurements; the bias estimate remains at \SI {3.91}{\degree \per \hour } because bias estimation is suspended at high rates}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Scenario 2: sun pointing (4 orbits)}{6}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sun-pointing error. First sample \ang {20.18}; maximum \ang {37.0} at \SI {40}{s}, while the torque-limited wheels absorb the initial rotation; below \ang {0.1} after \SI {5.1}{min}; thereafter a mean of \ang {0.0018} (maximum \ang {0.031}) for the remaining \SI {42}{h}.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pointing}{{6}{6}{Sun-pointing error. First sample \ang {20.18}; maximum \ang {37.0} at \SI {40}{s}, while the torque-limited wheels absorb the initial rotation; below \ang {0.1} after \SI {5.1}{min}; thereafter a mean of \ang {0.0018} (maximum \ang {0.031}) for the remaining \SI {42}{h}}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Sun pointing, motion view. (a) Rate: \SI {0.94}{\degree /s} at the first sample, below \SI {1.1e-4}{\degree /s} during the hold. (b) Momentum: 3.28 to \SI {2.85}{N.m.s}; the acquisition transfers it from the body into the wheels.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:sp_pair}{{7}{7}{Sun pointing, motion view. (a) Rate: \SI {0.94}{\degree /s} at the first sample, below \SI {1.1e-4}{\degree /s} during the hold. (b) Momentum: 3.28 to \SI {2.85}{N.m.s}; the acquisition transfers it from the body into the wheels}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Spacecraft orientation (3-2-1 Euler angles). Roll and pitch settle to constant values after the acquisition; yaw, the free rotation about the Sun-pointing axis, drifts about \ang {2} over the run.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:sp_orient}{{8}{7}{Spacecraft orientation (3-2-1 Euler angles). Roll and pitch settle to constant values after the acquisition; yaw, the free rotation about the Sun-pointing axis, drifts about \ang {2} over the run}{figure.caption.9}{}}
\newlabel{eq:desat}{{5}{7}{Scenario 2: sun pointing (4 orbits)}{equation.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Stored wheel momentum. The acquisition peaks at \SI {4.40}{N.m.s} (\SI {65}{s}, brief per-wheel saturation); afterwards solar radiation pressure refills the wheels slowly and the magnetorquers unload them around the \SI {3.2}{N.m.s} trigger level.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:wheels}{{9}{8}{Stored wheel momentum. The acquisition peaks at \SI {4.40}{N.m.s} (\SI {65}{s}, brief per-wheel saturation); afterwards solar radiation pressure refills the wheels slowly and the magnetorquers unload them around the \SI {3.2}{N.m.s} trigger level}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Disturbance torques and the momentum budget}{8}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Disturbance torques along the orbit (log scale). Gravity gradient dominates at perigee; solar radiation pressure is the smallest contribution but the only one that accumulates.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:dist}{{10}{8}{Disturbance torques along the orbit (log scale). Gravity gradient dominates at perigee; solar radiation pressure is the smallest contribution but the only one that accumulates}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Accumulated disturbance momentum. The per-orbit oscillation is stored and returned by the wheels; the steady growth, \SI {0.433}{N.m.s} over four orbits, must be removed by the magnetorquers.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:budget}{{11}{9}{Accumulated disturbance momentum. The per-orbit oscillation is stored and returned by the wheels; the steady growth, \SI {0.433}{N.m.s} over four orbits, must be removed by the magnetorquers}{figure.caption.12}{}}
