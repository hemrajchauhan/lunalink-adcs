\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Scenario 1: detumbling (4 orbits)}{2}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detumbling: the body rate drops in a step at every perigee pass (10.09 \(\rightarrow \) 8.73 \(\rightarrow \) 7.84 \(\rightarrow \) 7.25 \(\rightarrow \) \SI {6.77}{\degree /s} at the orbit marks).}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:detumble}{{1}{3}{Detumbling: the body rate drops in a step at every perigee pass (10.09 \(\rightarrow \) 8.73 \(\rightarrow \) 7.84 \(\rightarrow \) 7.25 \(\rightarrow \) \SI {6.77}{\degree /s} at the orbit marks)}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Detumbling, actuator view. (a) \(|\mathbf  H|\) drops 29.0 \(\rightarrow \) \SI {17.1}{N.m.s} in perigee steps. (b) The wheels are not used in this mode, so the stored momentum is exactly zero.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:dt_pair1}{{2}{3}{Detumbling, actuator view. (a) \(|\mathbf H|\) drops 29.0 \(\rightarrow \) \SI {17.1}{N.m.s} in perigee steps. (b) The wheels are not used in this mode, so the stored momentum is exactly zero}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Detumbling, environment view. (a) Uncontrolled attitude: the error fills the 0.3\,--\,\ang {179} band, as expected while tumbling. (b) Perigee spikes as in the pointing run, with a higher drag peak because the tumbling body also presents its largest face to the flow.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dt_pair2}{{3}{4}{Detumbling, environment view. (a) Uncontrolled attitude: the error fills the 0.3\,--\,\ang {179} band, as expected while tumbling. (b) Perigee spikes as in the pointing run, with a higher drag peak because the tumbling body also presents its largest face to the flow}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Detumbling, budget and estimator view. (a) Only \SI {0.058}{N.m.s} accumulate; tumbling averages most disturbance torque away. (b) Knowledge error up to \ang {13.7} between star fixes; the bias estimate stays at \SI {3.91}{\degree \per \hour } because learning is gated at high rates.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:dt_pair3}{{4}{4}{Detumbling, budget and estimator view. (a) Only \SI {0.058}{N.m.s} accumulate; tumbling averages most disturbance torque away. (b) Knowledge error up to \ang {13.7} between star fixes; the bias estimate stays at \SI {3.91}{\degree \per \hour } because learning is gated at high rates}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Scenario 2: sun pointing (4 orbits)}{4}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sun-pointing error: first sample \ang {20.18}, peak \ang {37.0} at \SI {40}{s} (rate transient against the wheel torque limit), below \ang {0.1} after \SI {5.1}{min}, then a hold at mean \ang {0.0018} (max \ang {0.031}) for the remaining \SI {42}{h}.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pointing}{{5}{5}{Sun-pointing error: first sample \ang {20.18}, peak \ang {37.0} at \SI {40}{s} (rate transient against the wheel torque limit), below \ang {0.1} after \SI {5.1}{min}, then a hold at mean \ang {0.0018} (max \ang {0.031}) for the remaining \SI {42}{h}}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sun pointing, motion view. (a) \(|\boldsymbol  \omega |\): \SI {0.94}{\degree /s} at start, below \SI {1.1e-4}{\degree /s} during the hold. (b) \(|\mathbf  H|\): 3.28 \(\rightarrow \) \SI {2.85}{N.m.s}; the acquisition moves momentum from the body into the wheels.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sp_pair}{{6}{5}{Sun pointing, motion view. (a) \(|\boldsymbol \omega |\): \SI {0.94}{\degree /s} at start, below \SI {1.1e-4}{\degree /s} during the hold. (b) \(|\mathbf H|\): 3.28 \(\rightarrow \) \SI {2.85}{N.m.s}; the acquisition moves momentum from the body into the wheels}{figure.caption.7}{}}
\newlabel{eq:desat}{{5}{5}{Scenario 2: sun pointing (4 orbits)}{equation.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Stored wheel momentum: acquisition transient to \SI {4.40}{N.m.s} at \SI {65}{s} (brief per-axis saturation), then the slow secular build-up with magnetic unloading around the \SI {3.2}{N.m.s} trigger.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:wheels}{{7}{6}{Stored wheel momentum: acquisition transient to \SI {4.40}{N.m.s} at \SI {65}{s} (brief per-axis saturation), then the slow secular build-up with magnetic unloading around the \SI {3.2}{N.m.s} trigger}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Disturbance torques and the momentum budget}{6}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Disturbance torques along the orbit (log scale). Gravity gradient dominates at perigee; solar pressure is smallest but carries the secular load.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:dist}{{8}{6}{Disturbance torques along the orbit (log scale). Gravity gradient dominates at perigee; solar pressure is smallest but carries the secular load}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Accumulated disturbance momentum: wiggle = cyclic (wheels store it), climb = secular (torquers dump it); \SI {0.433}{N.m.s} after four orbits, i.e.\ \SI {0.24}{N.m.s} per day.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:budget}{{9}{7}{Accumulated disturbance momentum: wiggle = cyclic (wheels store it), climb = secular (torquers dump it); \SI {0.433}{N.m.s} after four orbits, i.e.\ \SI {0.24}{N.m.s} per day}{figure.caption.10}{}}
