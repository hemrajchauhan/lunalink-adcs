\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Top: knowledge and control error (log scale); the knowledge error reaches \ang {1.03} during the acquisition and then holds \ang {0.0045} RMS. Bottom: the gyro-bias estimate; the initial values near \SI {100}{\degree \per \hour } result from the first measurements over-correcting during the acquisition, before convergence to \SI {0.25}{\degree \per \hour }.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:det}{{12}{9}{Top: knowledge and control error (log scale); the knowledge error reaches \ang {1.03} during the acquisition and then holds \ang {0.0045} RMS. Bottom: the gyro-bias estimate; the initial values near \SI {100}{\degree \per \hour } result from the first measurements over-correcting during the acquisition, before convergence to \SI {0.25}{\degree \per \hour }}{figure.caption.13}{}}
